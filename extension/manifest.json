{
  "manifest_version": 3,
  "name": "CaptureAsk",
  "version": "0.1.3",
  "description": "Capture the current Chrome tab and prepare it for your preferred AI.",
  "action": { "default_title": "CaptureAsk", "default_popup": "popup.html" },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "permissions": ["activeTab", "tabs", "storage", "downloads", "offscreen", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*"],
    "js": ["ai-focus.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{ "resources": ["offscreen.html"], "matches": ["<all_urls>"] }]
}
